# Music Mayhem settings for the home server: ~/services/musicgame/.env (mode 600).
# `devbot adopt music-mayhem 42` fills this in from the old Portainer stack.
# Placeholders in <angle brackets>; leave secrets empty here and set them on the server only.

# --- MongoDB (service "mongodb") ---
MONGO_INITDB_ROOT_USERNAME=<mongo-user>
MONGO_INITDB_ROOT_PASSWORD=<mongo-password>
MONGO_INITDB_DATABASE=music_game
MONGODB_URI=mongodb://<mongo-user>:<mongo-password>@mongodb:27017/music_game?authSource=admin

# --- Game service (Express + Socket.IO) ---
# Must stay 5000: the edge proxy (infra/nginx/edge.conf) forwards to game-service:5000.
PORT=5000
JWT_SECRET=
NODE_ENV=production
FRONTEND_URL=https://musicgame.delishad.com
ALLOWED_ORIGINS=https://musicgame.delishad.com
SONG_SERVICE_URL=http://song-service:5001
SONG_SERVICE_PATH=/app/songs
MAX_PARALLEL_DOWNLOADS=2

# --- Frontend (Next.js + NextAuth) ---
NEXT_PUBLIC_API_URL=https://musicgame.delishad.com
NEXT_BACKEND_URL=http://game-service:5000
NEXTAUTH_URL=https://musicgame.delishad.com
NEXTAUTH_SECRET=

# --- Song service (downloads, lyrics, playlists) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=
USE_YT_MUSIC=1
YT_MUSIC_ONLY=1
YTM_LYRICS_FIRST=0
USE_MUSICBRAINZ=1
MUSICBRAINZ_USER_AGENT=music-game/0.1 (<contact-email>)
SYNCEDLYRICS_PROVIDERS=
SYNCEDLYRICS_ENHANCED=1
MIN_LYRIC_SIMILARITY=

# yt-dlp tuning (optional; these are the compose defaults)
YTDLP_POT_PROVIDER_URL=http://pot-provider:4416
YTDLP_PLAYER_CLIENTS=mweb,web_safari,tv,default
YTDLP_REMOTE_COMPONENTS=ejs:github
# Set to /run/secrets/yt-dlp-cookies.txt to use /srv/musicgame/cookies.txt
YTDLP_COOKIES_FILE=

# --- Deprecated ---
# Only used by the old Docker Hub images; images are now built from this repo.
DOCKERHUB_USERNAME=
